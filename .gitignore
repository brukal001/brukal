# --- Brukal runtime artifacts (never commit engagement data) ---
runs/                      # audit logs + run outputs
vault/                     # Obsidian blackboard written during a run
docker/vault/*             # cage-mounted vault + cross-session lessons (engagement data)
!docker/vault/.gitkeep
*.audit.jsonl
audit.jsonl
results*.json              # experiment-harness dumps
scope.local.json           # personal/live scope files

# Per-engagement scope files are authorisation state for ONE target, not project code.
# Ignored by default so a `git add -A` mid-engagement cannot commit one; the lab scopes
# below are the deliberate exceptions. (`scope.json` needs no exception — it has a single
# dot and does not match this pattern.)
scope.*.json
!scope.htb.json
!scope.nexus.json

# Generated knowledge graph + the ignore files that keep it out of context. Regenerable
# from the source tree with `graphify extract . --code-only`; committing it would put a
# large derived artifact under review for no gain.
graphify-out/
.claudeignore
.graphifyignore

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets / local config ---
.env
.env.*
*.key
*.pem
# HTB / lab VPN configs — the WHOLE directory, not an extension pattern.
#
# These files embed a client PRIVATE KEY and an OpenVPN tls-crypt static key: publishing
# one hands over the lab identity itself. The rule here used to be `docker/vpn/*.ovpn`,
# which is correct-looking and wrong: a suffix lands AFTER the extension, so
# `config.ovpn.disabled` did not match it and was committed. (Purged from history
# 2026-08-13, before the repo was ever pushed.) Ignoring the directory means no rename,
# suffix, or backup copy — `.disabled`, `.disabled-for-2b`, `.bak`, `.orig` — can slip
# through the same gap again.
docker/vpn/*
!docker/vpn/.gitkeep

# Local engagement output (audit logs, per-run scope files)
runs/

# --- Editor / OS cruft ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
