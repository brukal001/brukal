  "cards": [
    {
      "dot": "rose",
      "title": "Five safety invariants",
      "items": [
        "No LLM inside the gate — a regex cannot be prompt-injected",
        "Fail-closed: anything ambiguous is DENIED",
        "Never trust an agent's self-report — the gate re-reads the command",
        "One execution path: Executor.run gates then logs",
        "Immutable scope, append-only hash-chained audit"
      ]
    },
    {
      "dot": "cyan",
      "title": "The gate",
      "items": [
        "Hard checks (AND): injection then parse then allowlist then target-in-scope then no smuggled host then rate-limit",
        "Hard checks can only DENY, never widen",
        "A soft risk score can ESCALATE to a human"
      ]
    },
    {
      "dot": "emerald",
      "title": "The one rule that protects all five",
      "items": [
        "Never give an agent the kali object — only ever a way to call executor.run"
      ]
    }
  ]
